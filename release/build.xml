<?xml version="1.0" encoding="utf-8"?>
<project default="all">
    <property name="bin" location="bin"/>
    <property name="lib" location="../lib"/>
    <property name="jarfile" location="${bin}/JHelioviewer.jar"/>

    <target name="clean">
        <delete dir="${bin}"/>
    </target>

    <target name="build">
        <ant antfile="../build.xml" target="all" inheritAll="false"/>
        <loadproperties>
            <zipentry zipfile="../JHelioviewer.jar" name="version.properties"/>
        </loadproperties>
        <property name="pkg.name" value="jhv-${jhv.version}.${jhv.revision}"/>
    </target>

    <target name="init" depends="build">
        <mkdir dir="${bin}"/>
        <copy todir="${bin}">
            <file file="../README.md"/>
            <file file="../LICENSE"/>
        </copy>
        <echo message="${jhv.version}.${jhv.revision}" file="${bin}/VERSION"/>
    </target>

    <macrodef name="native-bundle">
        <attribute name="platform"/>
        <sequential>
            <delete file="${bin}/natives-@{platform}.jar"/>
            <jar destfile="${bin}/natives-@{platform}.jar">
                <zipgroupfileset dir="${lib}" includes="**/*@{platform}*.jar"/>
            </jar>
        </sequential>
    </macrodef>

    <target name="jhv-natives" depends="init">
        <delete dir="${bin}/jhv"/>
        <copy todir="${bin}/jhv">
            <fileset dir="${lib}/jhv"/>
        </copy>
        <copy file="${lib}/natives-macos/libjhvmetalhost.dylib" todir="${bin}/jhv/macos-amd64"/>
        <copy file="${lib}/natives-macos/libjhvmetalhost.dylib" todir="${bin}/jhv/macos-arm64"/>
    </target>

    <target name="vendor-natives" depends="init">
        <native-bundle platform="linux"/>
        <native-bundle platform="macos"/>
        <native-bundle platform="windows"/>
    </target>

    <target name="jar-bundle" depends="init">
        <delete file="${jarfile}"/>
        <jar destfile="${jarfile}">
            <manifest>
                <attribute name="Automatic-Module-Name" value="org.helioviewer.jhv"/>
                <attribute name="Add-Exports" value="java.desktop/sun.awt java.desktop/sun.swing"/>
                <attribute name="Main-Class" value="org.helioviewer.jhv.JHelioviewer"/>
                <attribute name="Class-Path" value=". natives-linux.jar natives-macos.jar natives-windows.jar"/>
                <attribute name="version" value="${jhv.version}"/>
                <attribute name="revision" value="${jhv.revision}"/>
            </manifest>
            <zipgroupfileset dir="${lib}" includes="**/*.jar" excludes="**/*linux*.jar,**/*macos*.jar,**/*windows*.jar"/>
            <zipfileset src="../JHelioviewer.jar"/>
        </jar>
    </target>

    <target name="release-tar" depends="jar-bundle,jhv-natives,vendor-natives">
        <tar destfile="${bin}/${pkg.name}.bin.tar.gz" compression="gzip">
            <zipfileset dir="${bin}" includes="JHelioviewer.jar, natives-linux.jar, natives-macos.jar, natives-windows.jar, jhv/**, README.md, LICENSE" prefix="${pkg.name}"/>
        </tar>
    </target>

    <target name="all" depends="release-tar"/>

</project>
